FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM debian:13.4

ENV PYTHONUNBUFFERED=1
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential curl python3 ripgrep ffmpeg gcc python3-dev \
      libffi-dev procps git openssh-client tini ca-certificates && \
    rm -rf /var/lib/apt/lists/*

COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /opt/hermes

# Install a gateway-focused dependency set. The full upstream Dockerfile builds
# web/TUI assets and Playwright browsers, which makes Railway deployments very
# large/slow. Chief's always-on cloud service only needs the gateway plus core
# tools, Telegram/Slack messaging, cron, CLI helpers, MCP/ACP, and memory.
COPY pyproject.toml uv.lock ./
RUN touch README.md && \
    uv sync --frozen --no-install-project \
      --extra messaging \
      --extra slack \
      --extra cli \
      --extra pty \
      --extra mcp \
      --extra honcho \
      --extra acp \
      --extra web

COPY . .
RUN uv pip install --no-cache-dir --no-deps -e "."

# Cloudflare-resistant TLS for the ChatGPT Codex backend
# (agent/curl_cffi_transport.py). Installed into the same .venv AFTER the frozen
# `uv sync` so it never touches uv.lock — curl_cffi ships manylinux wheels with a
# bundled libcurl-impersonate, so no build toolchain or lockfile change is needed.
RUN uv pip install --no-cache-dir "curl_cffi>=0.7,<1"

RUN mkdir -p /opt/data && chmod -R a+rX /opt/hermes

ENTRYPOINT ["/usr/bin/tini", "-g", "--"]
